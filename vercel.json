{
    "builds": [
        {
            "src": "client/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "build",
                "buildCommand": "npm run build:vercel"
            }
        }
    ],
    "env": {
        "CI": "false",
        "GENERATE_SOURCEMAP": "false"
    },
    "build": {
        "env": {
            "CI": "false",
            "GENERATE_SOURCEMAP": "false"
        }
    },
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/.*",
            "dest": "/client/build/index.html"
        }
    ]
}